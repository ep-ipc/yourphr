# YourPHR — bare metal / VM bootstrap
#
#   cp .env.baremetal.example .env
#
# Only what must be correct BEFORE the app can serve its Admin screen belongs here. Everything
# else has a shipped default and is changed at Admin -> Configuration.
# See docs/configuration-system.md.
#
# The shipped defaults are CONTAINER paths (/opt/fasten/...). Outside a container every one of
# them is wrong, which is why this file is longer than the Docker one.

# Where this instance keeps everything it owns and must not lose: database, generated JWT signing
# key, config overrides, backups. Back this directory up.
YOURPHR_STORAGE_DATA_DIR=/var/lib/yourphr

# The database file. Does NOT derive from the data dir — set it explicitly.
YOURPHR_DATABASE_LOCATION=/var/lib/yourphr/fasten.db

# Where the compiled Angular app lives. WITHOUT THIS the backend starts and serves no interface,
# with nothing explaining why — the default points inside the container image.
YOURPHR_WEB_SRC_FRONTEND_PATH=/opt/yourphr/web

# At-rest database encryption is ON by default. The key is required, has no default, and must be
# supplied on EVERY start — a key stored beside the database protects nothing.
#   generate with: openssl rand -hex 32
# NOTE: while encryption is on, backup and restore are refused (see docs/deployment/README.md).
# To run unencrypted instead, set YOURPHR_DATABASE_ENCRYPTION_ENABLED=false and omit the key.
YOURPHR_DATABASE_ENCRYPTION_KEY=

# Optional: only if 8080 is taken, or a reverse proxy expects otherwise.
# YOURPHR_WEB_LISTEN_PORT=8080

# Optional: only when serving under a path prefix, e.g. https://example.com/yourphr
# YOURPHR_WEB_LISTEN_BASEPATH=
